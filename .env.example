# Base de données Postgres (Railway la remplit avec ${{Postgres.DATABASE_URL}})
DATABASE_URL=
# Clé secrète longue et aléatoire (ex. : openssl rand -hex 32)
PAYLOAD_SECRET=
# Adresse publique du site, sans slash final
NEXT_PUBLIC_SITE_URL=https://performancetransmission.ch
# Mettre à true UNIQUEMENT quand le domaine pointe vers Railway (active Google + redirection 301)
ALLOW_INDEXING=false
# Dossier des images envoyées dans l'admin (monter un volume Railway ici)
MEDIA_DIR=/data/media

# Optionnel : email de notification à chaque demande de contact
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=site@performancetransmission.ch
CONTACT_TO=compta@performancetransmission.ch
